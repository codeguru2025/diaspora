# ─────────────────────────────────────────────────────────────────────────────
# Diaspora Funeral Services website — environment
# Copy to `.env.local` for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this site (canonical URLs, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── POL263 integration (server-side only — never exposed to the browser) ─────
# Base URL of the POL263 API. Use the DFS tenant host once provisioned,
# e.g. https://dfs.pol263.app  (subdomain) or the DFS custom domain.
POL263_API_BASE_URL=

# The DFS organization_id in POL263 (the DFS tenant).
POL263_ORG_ID=

# Optional: an agent / campaign referral code registered in POL263 for the DFS
# org. Required TODAY for the live quote engine and lead capture, because the
# existing public endpoints are ref-scoped. Remove once org-scoped, ref-optional
# public endpoints are added (see docs/POL263-INTEGRATION.md).
POL263_PUBLIC_REF=

# Optional server-to-server bearer token, if POL263 provisions one for this site.
POL263_API_TOKEN=

# ─── Customer portal ─────────────────────────────────────────────────────────
# The POL263 client portal URL on the DFS domain (the /client area). Shown on
# the /account page as "Sign in to the customer portal".
NEXT_PUBLIC_POL263_PORTAL_URL=

# ─── Analytics (consent-gated) ───────────────────────────────────────────────
# Set either/both and the <Analytics> component loads that provider ONLY after
# the visitor accepts analytics in the consent banner. Nothing loads by default,
# and the banner itself only appears when at least one of these is set.
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=diasporafuneralservices.com
